{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaik.tools/schemas/event.schema.json",
  "title": "MOSAIK Event",
  "description": "Evento temporal detectado o inferido por MOSAIK.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "timestamp_s", "score", "confidence"],
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "timestamp_s": { "type": ["number", "null"] },
    "duration_s": { "type": ["number", "null"], "minimum": 0 },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "area": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
