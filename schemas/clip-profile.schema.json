{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaik.tools/schemas/clip-profile.schema.json",
  "title": "MOSAIK ClipProfile",
  "description": "Perfil reutilizable de una visual analizada por INSTAR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_type", "profile_id", "generated_at", "analyzer", "source", "technical", "visual", "events", "compatibility"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "profile_type": { "const": "ClipProfile" },
    "profile_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "analyzer": { "$ref": "#/$defs/analyzer" },
    "source": { "$ref": "#/$defs/source" },
    "technical": { "type": "object" },
    "visual": { "type": "object" },
    "events": { "type": "object" },
    "temporal_series": { "type": ["object", "null"] },
    "compatibility": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode", "backend"],
      "properties": {
        "name": { "const": "INSTAR" },
        "version": { "type": "string" },
        "mode": { "type": "string" },
        "backend": { "type": "string" }
      }
    },
    "fingerprint": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "filename", "extension", "fingerprint"],
      "properties": {
        "path": { "type": "string" },
        "filename": { "type": "string" },
        "extension": { "type": "string" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
