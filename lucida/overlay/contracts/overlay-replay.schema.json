{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaik:lucida:overlay-replay",
  "title": "LUCIDA Overlay Replay",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_type", "schema_version", "records"],
  "properties": {
    "contract_type": { "const": "LucidaOverlayReplay" },
    "schema_version": { "const": "0.1" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "view", "cursor", "recovery"],
            "properties": {
              "kind": { "const": "snapshot" },
              "view": { "$ref": "overlay-view.schema.json" },
              "cursor": { "$ref": "overlay-cursor.schema.json" },
              "recovery": { "type": "boolean" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "changes", "cursor"],
            "properties": {
              "kind": { "const": "delta" },
              "changes": {
                "type": "array",
                "maxItems": 7,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "before", "after"],
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "status",
                        "overlay_status",
                        "capabilities",
                        "pending_proposals",
                        "unknowns",
                        "next_attention",
                        "safety"
                      ]
                    },
                    "before": {},
                    "after": {}
                  }
                }
              },
              "cursor": { "$ref": "overlay-cursor.schema.json" }
            }
          }
        ]
      }
    }
  }
}
